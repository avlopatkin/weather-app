<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.19.xsd">

    <changeSet id="004-add-user-reference" author="your_name">
        <addColumn tableName="locations">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_locations_user"/>
            </column>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="locations"
                baseColumnNames="user_id"
                constraintName="fk_locations_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>